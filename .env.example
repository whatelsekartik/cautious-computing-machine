# CivicWatch AI Studio — environment variables
#
# Two separate environments use this file:
#
#   VERCEL (cloud)  → every variable in section 1–3
#   LOCAL MAC       → section 4 only (the connector), plus optional overrides
#                     documented in config/civicwatch.example.env
#
# Copy the values you need into the Vercel dashboard (Project → Settings →
# Environment Variables). Never commit real secrets.

# ---------------------------------------------------------------------------
# 1. Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Connection
# pooling" (port 6543) is recommended for serverless. Keep sslmode=require;
# a bare "postgresql://" URL without sslmode defaults to TLS in CivicWatch.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Explicit backend selection (optional; inferred from DATABASE_URL).
# CIVICWATCH_DB_BACKEND=postgres

# ---------------------------------------------------------------------------
# 2. Dashboard authentication
# ---------------------------------------------------------------------------
# Long random string, e.g.  openssl rand -hex 32
# Operators exchange it once for a signed, HttpOnly session cookie.
CIVICWATCH_ADMIN_TOKEN=replace-with-a-64-character-random-string

# ---------------------------------------------------------------------------
# 3. Evidence storage (private S3-compatible bucket)
# ---------------------------------------------------------------------------
# Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO or any S3-compatible
# service. The bucket must stay private: evidence is served through short-lived
# presigned URLs only.
CIVICWATCH_S3_BUCKET=civicwatch-evidence
CIVICWATCH_S3_REGION=ap-south-1
CIVICWATCH_S3_ACCESS_KEY_ID=
CIVICWATCH_S3_SECRET_ACCESS_KEY=
# Only for non-AWS providers:
# CIVICWATCH_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# CIVICWATCH_S3_FORCE_PATH_STYLE=1
# CIVICWATCH_S3_PREFIX=civicwatch

# Storage backend (s3 is inferred when a bucket is configured).
# CIVICWATCH_STORAGE=s3

# ---------------------------------------------------------------------------
# 4. Local connector (macOS only — never set these on Vercel)
# ---------------------------------------------------------------------------
# Created in the dashboard: Settings → Local connectors → Create connector.
# The token is displayed once. Put both values in config/connector.env and use
# "Start Cloud Connector.command", or export them in your shell.
CIVICWATCH_CLOUD_URL=https://your-project.vercel.app
CIVICWATCH_CONNECTOR_TOKEN=cwconn_replace_me
# CIVICWATCH_CONNECTOR_INTERVAL=20

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed for the sandbox preview; never enable on a real deployment.
# CIVICWATCH_ALLOW_REMOTE=0
# CIVICWATCH_CORS_ORIGINS=https://your-custom-domain.example
