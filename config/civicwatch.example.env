# CivicWatch AI Studio — optional environment overrides.
#
# The launchers need none of these: sensible defaults are compiled in and all
# normal configuration (model, confidence, retention, sampling) lives in the
# Settings page. Use this file only for packaging, CI or a non-default layout.
#
#   cp config/civicwatch.example.env .env       # or export these in your shell
#   CIVICWATCH_PORT=8010 ./Start\ CivicWatch.command

# Where the SQLite database, footage, evidence, models and logs live.
# Default: <repository>/data
CIVICWATCH_DATA_DIR=/Users/you/Library/Application Support/CivicWatch

# Bind address. The launchers always use 127.0.0.1 so the API is unreachable
# from the network. Only change this on a machine you fully control.
CIVICWATCH_HOST=127.0.0.1

# Loopback port for the API and the studio.
CIVICWATCH_PORT=8000

# Escape hatch for sandboxed previews only. CivicWatch refuses non-loopback
# requests unless this is exactly "1". Never enable it on a machine holding
# real footage.
CIVICWATCH_ALLOW_REMOTE=0

# Optional: use a virtual environment outside the project folder (CI, shared
# installs). The launchers create and manage <repository>/.venv by default.
# CIVICWATCH_VENV=/Users/you/.venvs/civicwatch
