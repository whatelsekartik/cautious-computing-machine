#!/bin/bash
# Create CivicWatch App.command — optional: builds CivicWatch.app in this folder
# so the studio can be started from Launchpad/Applications with one click.
# Run it again after moving the project folder (the app stores its path).

cd "$(dirname "$0")" || exit 1
# shellcheck source=launchers/lib/common.sh
source launchers/lib/common.sh

ensure_dirs
cw_banner
require_macos

APP="$CIVICWATCH_ROOT/CivicWatch.app"

if [ ! -x "$PY" ] || [ ! -f "$CIVICWATCH_ROOT/frontend/dist/index.html" ]; then
  die "Run \"Setup CivicWatch.command\" first."
fi

log_step "Building CivicWatch.app"
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"

cat >"$APP/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>CivicWatch</string>
  <key>CFBundleDisplayName</key><string>CivicWatch AI Studio</string>
  <key>CFBundleIdentifier</key><string>local.civicwatch.studio</string>
  <key>CFBundleVersion</key><string>1.0.0</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleExecutable</key><string>CivicWatch</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>LSUIElement</key><false/>
  <key>NSHumanReadableCopyright</key><string>CivicWatch AI Studio · local-first civic monitoring</string>
</dict>
</plist>
PLIST

cat >"$APP/Contents/MacOS/CivicWatch" <<LAUNCHER
#!/bin/bash
# Generated by "Create CivicWatch App.command" — safe to delete and rebuild.
ROOT="$CIVICWATCH_ROOT"
LOG_DIR="\$ROOT/data/logs"
mkdir -p "\$LOG_DIR"

if [ ! -x "\$ROOT/.venv/bin/python" ]; then
  osascript -e 'display dialog "CivicWatch is not installed yet. Run Setup CivicWatch.command in the CivicWatch folder." with title "CivicWatch AI Studio" buttons {"OK"} default button "OK" with icon caution'
  exit 1
fi

"\$ROOT/Start CivicWatch.command" --no-browser >>"\$LOG_DIR/app.log" 2>&1
STATUS=\$?
if [ \$STATUS -ne 0 ]; then
  DETAIL=\$(tail -n 12 "\$LOG_DIR/backend.log" 2>/dev/null | tr '"' "'" | tr '\n' ' ')
  osascript -e "display dialog \"CivicWatch could not start.\n\n\$DETAIL\n\nLog: \$LOG_DIR/backend.log\" with title \"CivicWatch AI Studio\" buttons {\"OK\"} default button \"OK\" with icon stop"
  exit \$STATUS
fi

open "http://127.0.0.1:${CIVICWATCH_PORT:-8000}"
LAUNCHER
chmod +x "$APP/Contents/MacOS/CivicWatch"
log_ok "Application bundle created"

log_step "Adding the app icon"
ICON_SRC="$CIVICWATCH_ROOT/assets/icon.png"
if [ -f "$ICON_SRC" ] && command -v sips >/dev/null 2>&1 && command -v iconutil >/dev/null 2>&1; then
  ICONSET="$RUN_DIR/AppIcon.iconset"
  rm -rf "$ICONSET"
  mkdir -p "$ICONSET"
  for size in 16 32 64 128 256 512; do
    sips -z $size $size "$ICON_SRC" --out "$ICONSET/icon_${size}x${size}.png" >/dev/null 2>&1
    double=$((size * 2))
    sips -z $double $double "$ICON_SRC" --out "$ICONSET/icon_${size}x${size}@2x.png" >/dev/null 2>&1
  done
  if iconutil -c icns "$ICONSET" -o "$APP/Contents/Resources/AppIcon.icns" 2>/dev/null; then
    log_ok "Icon installed"
  else
    log_warn "Could not build the .icns icon; the app still works."
  fi
  rm -rf "$ICONSET"
else
  log_warn "Icon tooling unavailable; the app still works."
fi

if command -v codesign >/dev/null 2>&1; then
  codesign --force --deep --sign - "$APP" >/dev/null 2>&1 \
    && log_ok "Ad-hoc signed (runs locally without warnings)" \
    || log_warn "Ad-hoc signing skipped; macOS may ask for confirmation on first launch."
fi

log_step "Registering with Launch Services"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$APP" >/dev/null 2>&1 || true

cat <<EOF

  ${CW_GREEN}CivicWatch.app is ready${CW_RESET} — $APP

  Double-click it to start the studio, or drag it into /Applications.
  It starts the same local server as "Start CivicWatch.command".
  If you move the project folder, re-run this script.

EOF
if [ -t 0 ]; then
  read -r -p "Press Return to close this window… " _
fi
